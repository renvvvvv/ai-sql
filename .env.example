# AI Service Configuration
# Replace with your AI service endpoint and API key
NEXT_PUBLIC_AI_ENDPOINT=http://localhost:3001/chat/completions
NEXT_PUBLIC_AI_API_KEY=your-api-key-here
NEXT_PUBLIC_AI_MODEL=gpt-3.5-turbo

# Development Configuration
NODE_ENV=development
PORT=3000

# Proxy Configuration (if using proxy server)
PROXY_PORT=3001
PROXY_TARGET=https://your-ai-service.com